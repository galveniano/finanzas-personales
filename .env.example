# Copia este fichero como .env y rellena lo que tengas. El .env nunca se sube a GitHub.

# Comunidad autónoma de residencia
CCAA=Murcia
# Ruta de la base de datos (por defecto data/finanzas.db)
FINANZAS_DB=data/finanzas.db
# Cada cuántas horas sincroniza sola mientras la app está abierta (0 = solo a mano)
SYNC_HORAS=6

# Indexa Capital: token de API (área privada > Configuración > Aplicaciones)
INDEXA_TOKEN=

# Banco Sabadell vía Enable Banking (open banking PSD2, solo lectura)
# ID de la aplicación que registras en https://enablebanking.com/cp/applications
ENABLE_BANKING_APP_ID=
# Clave privada .pem descargada al crear la aplicación (guárdala en secretos/)
ENABLE_BANKING_KEY=secretos/enablebanking.pem
# Debe coincidir con la URL de vuelta registrada en Enable Banking
ENABLE_BANKING_REDIRECT_URL=https://localhost:8000/sabadell/vuelta

# --- Solo si la publicas (Vercel). En tu ordenador puedes dejarlo vacío. ---
# Postgres (Vercel > Storage > Neon la rellena sola)
DATABASE_URL=
# Inicio de sesión con Google: ID de cliente OAuth (tipo "Aplicación web")
GOOGLE_CLIENT_ID=
# Emails que pueden entrar, separados por comas
EMAILS_PERMITIDOS=
# Cadena aleatoria larga (openssl rand -hex 32) para firmar la sesión
SESSION_SECRET=
# Otra cadena aleatoria para la tarea diaria de sincronización
CRON_SECRET=

# --- Asistente y lectura de facturas de Drive (Claude) ---
# Clave de la API de Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Tu nombre y NIF, para distinguir las facturas que emites de las que recibes
NOMBRE_TITULAR=
NIF_TITULAR=
